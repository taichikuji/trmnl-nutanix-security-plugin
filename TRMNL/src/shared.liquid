{% template nutanix_subject %}
{%- if mode == 'nxvd' -%}
  {%- assign first_cve = entry.cve | split: ', ' | first -%}
  {{- first_cve | default: entry.cesa | default: entry.package | default: 'Vulnerability fix' | escape -}}
{%- else -%}
  {%- assign subject = entry.summary | strip -%}
  {%- assign prefix = subject | split: ' for ' | first | downcase -%}
  {%- if prefix == 'investigation and breakfix guidance' or prefix == 'investigation and break-fix guidance' or prefix == 'investigation and break fix guidance' -%}
    {%- assign prefix_length = prefix.size | plus: 5 -%}
    {%- assign subject = subject | slice: prefix_length, subject.size -%}
  {%- endif -%}
  {{- subject | default: 'Security advisory' | escape -}}
{%- endif -%}
{% endtemplate %}

{% template nutanix_table %}
{% assign current_mode = mode | default: 'advisories' %}
{% assign records = content.body | reverse %}
{% assign heading = 'Security advisories' %}
{% assign lead_label = 'Latest advisory' %}
{% assign table_heading = 'Earlier advisories' %}
{% if content.criticality_first %}
  {% assign lead_label = 'By criticality' %}
  {% assign table_heading = 'More advisories' %}
{% endif %}
{% if current_mode == 'nxvd' %}
  {% assign records = nxvd.rows %}
  {% assign heading = 'Vulnerability fixes' %}
  {% assign lead_label = 'By CVSS' %}
  {% assign table_heading = 'Released fixes' %}
{% endif %}
{% if feed_state == 'STALE' %}
  {% assign lead_label = saved_at | date: '%Y-%m-%d' | prepend: 'Saved ' %}
{% endif %}
{% assign lead = records.first %}
{% comment %}Bound the markup before paint. Large and portrait screens show extra rows with framework classes.{% endcomment %}
{% assign compact = false %}
{% assign row_limit = 9 %}
{% assign regular_rows = 4 %}
{% assign portrait_rows = 8 %}
{% assign score_visibility = 'hidden lg:table-cell' %}
{% assign severity_width = 'w--24 lg:w--32' %}
{% case view %}
  {% when 'full' %}
    {% assign row_limit = 16 %}
    {% assign severity_width = 'w--32' %}
    {% assign score_visibility = '' %}
  {% when 'half_horizontal' %}
    {% assign compact = true %}
    {% assign row_limit = 5 %}
    {% assign regular_rows = 3 %}
    {% assign portrait_rows = 3 %}
  {% when 'quadrant' %}
    {% assign compact = true %}
    {% assign row_limit = 2 %}
    {% assign regular_rows = 0 %}
    {% assign portrait_rows = 0 %}
{% endcase %}
{% if current_mode == 'nxvd' %}
  {% assign severity_width = 'w--28' %}
{% endif %}

<style>
  .nutanix-table { table-layout: fixed; }
  {% if view == 'full' %}
    .nutanix-table-space {
      container: nutanix-table / size;
      font-size: calc(1px * var(--ui-scale));
    }
    {% comment %}The small table uses a 24px header and 31px rows at the screen's UI scale. Leave 1px extra before revealing a row.{% endcomment %}
    {% for row in (5..row_limit) %}
      @container nutanix-table (height >= {{ row | times: 31 | plus: 25 }}em) {
        .trmnl .screen .nutanix-table tbody tr:nth-child({{ row }}) { display: table-row; }
      }
    {% endfor %}
  {% endif %}
  .nutanix-line { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nutanix-headline {
    max-block-size: 2lh;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
</style>

<div class="layout layout--col layout--stretch gap--none">
  <section class="flex flex--col h--full w--full {% if view == 'full' %}gap--xsmall lg:gap--small{% else %}gap--small{% endif %}" aria-label="Nutanix {{ heading }}">
    <header class="flex flex--row flex--left flex--center-y gap--small w--full px--3 no-shrink" data-ns-mast>
      <svg viewBox="16 16 224 224" class="w--8 h--8 lg:w--10 lg:h--10 no-shrink" aria-hidden="true">
        <path fill="currentColor" fill-rule="evenodd" d="M27 27H90L128 65L166 27H229V90L191 128L229 166V229H166L128 191L90 229H27V166L65 128L27 90Z M35 35H86L128 77L170 35H221V86L179 128L221 170V221H170L128 179L86 221H35V170L77 128L35 86Z"/>
      </svg>
      <div class="grow w--min-0 py--1">
        <div class="label label--base text--bold">NUTANIX</div>
        <div class="title title--base lg:title--large text--bold" role="heading" aria-level="1">{{ heading }}</div>
      </div>
      {% if portal_url != blank and view == 'full' %}
        <div class="flex no-shrink w--[68px] lg:w--[74px]" role="img" aria-label="QR code for the Nutanix {{ heading | downcase }} table">
          {{ portal_url | qr_code: 3, 'l' }}
        </div>
      {% endif %}
    </header>

    {% if feed_state == 'ERROR' or lead == blank %}
      <div class="flex flex--col flex--center-y gap--small grow w--full p--3">
        {% if feed_state == 'ERROR' %}
          <div class="label label--outline">{{ source_error | default: 'Source error' | escape }}</div>
          <div class="title text--center">Nutanix feed unavailable</div>
          <div class="description description--large text--center">{{ source_message | default: 'Check the plugin Debug Logs.' | escape }}</div>
        {% elsif current_mode == 'nxvd' %}
          <div class="title text--center">No released fixes on this page</div>
          <div class="description description--large text--center">Check the selected product in NXVD.</div>
        {% else %}
          <div class="title text--center">No advisories returned</div>
          <div class="description description--large text--center">Check the Nutanix advisory feed.</div>
        {% endif %}
      </div>
    {% else %}
      <div class="flex flex--col w--full {% if view == 'full' %}gap--xsmall lg:gap--small grow{% else %}gap--small{% endif %} h--min-0 {% if records.size > 1 and view == 'half_horizontal' %}landscape:grid landscape:grid--cols-2{% endif %}">
        <article class="inverse flex flex--col flex--left gap--none px--3 lg:px--4 {% if view == 'full' %}py--1 lg:py--3 no-shrink{% else %}py--2{% endif %} w--full w--min-0 self--start" data-ns-lead>
          <div class="flex flex--row flex--between flex--center-y flex--wrap gap--xsmall w--full">
            <span class="label label--base lg:label--large text--bold" data-ns-order>{{ lead_label }}</span>
            <span class="label label--base label--outline">{{ lead.severity | default: lead.criticality | default: 'Unrated' | escape }}</span>
          </div>
          <div class="title {% if view == 'full' %}title--xlarge lg:title--xxlarge{% elsif view == 'quadrant' %}title--base lg:title--large{% else %}title--large{% endif %} text--bold nutanix-headline my--1 w--full" data-ns-subject role="heading" aria-level="2">{% render 'nutanix_subject', entry: lead, mode: current_mode %}</div>
          <div class="description description--large nutanix-line w--full">
            {% if current_mode == 'nxvd' %}
              {% if lead.cvss != blank %}<strong>CVSS <span data-ns-score>{{ lead.cvss | escape }}</span></strong> · {% endif %}
              {{ lead.product | escape }}{% if lead.package != blank %} · {{ lead.package | escape }}{% endif %}
              {% if lead.fixed != blank %}
                <span{% if view != 'full' %} class="block nutanix-line"{% endif %}>{% if view == 'full' %}· {% endif %}<strong>Fixed in</strong> {{ lead.fixed | escape }}</span>
              {% endif %}
            {% else %}
              {% if lead.date != blank %}<strong>{{ lead.date | date: '%b %-d, %Y' | escape }}</strong> · {% endif %}SA #{{ lead.advisoryNumber | escape }}
              {% if lead.affectedVersions != blank %}
                <span{% if view != 'full' %} class="block nutanix-line"{% endif %}>{% if view == 'full' %}· {% endif %}Affects {{ lead.affectedVersions | escape }}</span>
              {% endif %}
            {% endif %}
          </div>
        </article>

        {% if records.size > 1 %}
          <section class="w--full w--min-0 px--3 lg:px--4 {% if view == 'quadrant' %}hidden lg:block{% elsif view == 'full' %}grow basis--0 h--min-0 nutanix-table-space{% endif %}" aria-label="{{ table_heading }}">
            <table class="table nutanix-table w--full {% if compact or view == 'full' %}table--small{% endif %}">
              <thead>
                <tr>
                  <th scope="col"><span class="label label--base text--bold">{{ table_heading }}</span></th>
                  {% if view == 'full' %}
                    <th scope="col" class="{% if current_mode == 'nxvd' %}w--28 landscape:w--48 lg:w--64 lg:landscape:w--72{% else %}w--32 landscape:w--40 lg:w--48{% endif %}">
                      <span class="label label--base text--bold">{% if current_mode == 'nxvd' %}Product / fix{% else %}Published{% endif %}</span>
                    </th>
                  {% endif %}
                  {% if current_mode == 'nxvd' %}
                    <th scope="col" class="w--12 text--right {{ score_visibility }}"><span class="label label--base text--bold pr--2">CVSS</span></th>
                  {% endif %}
                  <th scope="col" class="text--right {{ severity_width }}">
                    <span class="label label--base text--bold">Severity</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {% for entry in records offset: 1 limit: row_limit %}
                  {% assign severity = entry.severity | default: entry.criticality | default: 'Unrated' %}
                  {% assign details = entry.product %}
                  {% assign detail_suffix = entry.fixed %}
                  {% unless current_mode == 'nxvd' %}
                    {% assign details = entry.date | date: '%b %-d, %Y' %}
                    {% assign detail_suffix = entry.advisoryNumber | prepend: '#' %}
                  {% endunless %}
                  <tr data-ns-row{% if forloop.index > regular_rows %} class="hidden{% unless view == 'full' %} {% if forloop.index <= portrait_rows %}portrait:table-row {% endif %}lg:table-row{% endunless %}"{% endif %}>
                    <td>
                      <div class="label label--base block pr--2 text--bold nutanix-line">{% render 'nutanix_subject', entry: entry, mode: current_mode %}</div>
                      {% if view == 'half_vertical' %}
                        <div class="label label--base block pr--2 nutanix-line">
                          {{ details | escape }}
                        </div>
                      {% endif %}
                    </td>
                    {% if view == 'full' %}
                      <td>
                        <div class="label label--base block pr--2 nutanix-line">
                          {{ details | escape }}{% if detail_suffix != blank %}{% if details != blank %} · {% endif %}{{ detail_suffix | escape }}{% endif %}
                        </div>
                      </td>
                    {% endif %}
                    {% if current_mode == 'nxvd' %}
                      <td class="text--right {{ score_visibility }}"><span class="label label--base text--bold pr--2">{{ entry.cvss | escape }}</span></td>
                    {% endif %}
                    <td class="text--right">
                      <div class="flex flex--row flex--right flex--center-y">
                        <span class="label label--base nutanix-line w--min-0 {% if severity == 'Critical' %}label--filled{% else %}label--outline{% endif %}">{{ severity | escape }}</span>
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </section>
        {% endif %}
      </div>
    {% endif %}
  </section>
</div>
{% endtemplate %}
