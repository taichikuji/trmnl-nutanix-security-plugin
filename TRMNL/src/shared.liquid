{% template nutanix_subject %}
{%- if mode == 'nxvd' -%}
  {%- assign first_cve = entry.cve | split: ', ' | first -%}
  {{- first_cve | default: entry.cesa | default: entry.package | default: 'Vulnerability fix' | escape -}}
{%- else -%}
  {%- assign subject = entry.summary | strip -%}
  {%- assign prefix = subject | split: ' for ' | first | downcase -%}
  {%- if prefix == 'investigation and breakfix guidance' or prefix == 'investigation and break-fix guidance' -%}
    {%- assign prefix_length = prefix.size | plus: 5 -%}
    {%- assign subject = subject | slice: prefix_length, subject.size -%}
  {%- endif -%}
  {{- subject | default: 'Security advisory' | escape -}}
{%- endif -%}
{% endtemplate %}

{% template nutanix_severity %}
{%- assign severity = value | default: 'Unrated' -%}
<span class="ns-severity{% if severity == 'Critical' %} ns-severity--critical{% endif %}">{{ severity | escape }}</span>
{% endtemplate %}

{% template nutanix_table %}
{% assign current_mode = mode | default: 'advisories' %}
{% assign is_nxvd = false %}
{% assign heading = 'Security advisories' %}
{% assign records = content.body | reverse %}
{% assign site_url = 'https://portal.nutanix.com/page/security/security-advisories/list' %}
{% if current_mode == 'nxvd' %}
  {% assign is_nxvd = true %}
  {% assign heading = 'Vulnerability fixes' %}
  {% assign records = nxvd.rows %}
  {% assign site_url = 'https://portal.nutanix.com/page/security/security-vulnerabilities/list' %}
{% endif %}
{% assign record_count = records.size | default: 0 %}
{% assign lead = records.first %}
{% assign row_limit = 4 %}
{% if view == 'half_horizontal' %}{% assign row_limit = 2 %}{% endif %}
{% if view == 'quadrant' %}{% assign row_limit = 0 %}{% endif %}
<style>
  .ns { container-type:size; width:100%; height:100%; }
  .ns, .ns * { box-sizing:border-box; }
  .ns-board {
    --u:min(.145cqw,.215cqh);
    --pad:calc(16 * var(--u));
    --rule:max(1px,calc(.75 * var(--u)));
    width:100%;
    height:100%;
    display:grid;
    grid-template-rows:auto minmax(0,1fr) auto;
    border:var(--rule) solid #151515;
    border-radius:calc(9 * var(--u));
    overflow:hidden;
    background:#fff;
    color:#151515;
    font-family:Arial, Helvetica, sans-serif;
  }
  .ns--half_horizontal .ns-board { --u:min(.145cqw,.43cqh); }
  .ns--half_vertical .ns-board { --u:min(.29cqw,.215cqh); }
  .ns--quadrant .ns-board { --u:min(.29cqw,.43cqh); }
  .ns-mast {
    display:flex;
    align-items:center;
    gap:calc(11 * var(--u));
    padding:calc(9 * var(--u)) var(--pad) calc(10 * var(--u));
    background:#151515;
    color:#fff;
  }
  .ns-mark {
    width:calc(33 * var(--u));
    height:calc(33 * var(--u));
    flex:none;
    fill:currentColor;
  }
  .ns-brand {
    font-size:calc(12 * var(--u));
    font-weight:700;
    letter-spacing:.15em;
    line-height:1.05;
  }
  .ns-heading {
    margin:calc(3 * var(--u)) 0 0;
    font-size:calc(25 * var(--u));
    font-weight:750;
    line-height:1.05;
  }
  .ns-scope {
    flex:none;
    margin-inline-start:auto;
    font-size:calc(14 * var(--u));
    font-weight:700;
    font-variant-numeric:tabular-nums;
    text-align:right;
  }
  .ns-content { min-height:0; display:flex; flex-direction:column; }
  .ns-feature {
    display:grid;
    grid-template-columns:minmax(0,1fr) auto;
    align-items:center;
    gap:calc(18 * var(--u));
    padding:calc(15 * var(--u)) var(--pad);
  }
  .ns-meta {
    display:flex;
    align-items:baseline;
    gap:calc(7 * var(--u));
    flex-wrap:wrap;
    font-size:calc(14 * var(--u));
    font-weight:700;
    line-height:1.2;
  }
  .ns-meta-label { text-transform:uppercase; letter-spacing:.08em; }
  .ns-meta a, .ns-foot a { color:inherit; text-decoration:underline; text-underline-offset:.14em; }
  .ns-clip {
    display:-webkit-box;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:var(--lines,1);
    overflow:hidden;
    overflow-wrap:anywhere;
  }
  .ns-subject {
    --lines:2;
    margin:calc(4 * var(--u)) 0;
    font-size:calc(36 * var(--u));
    font-weight:800;
    letter-spacing:-.04em;
    line-height:1.05;
  }
  .ns-detail { font-size:calc(16 * var(--u)); line-height:1.25; }
  .ns-impact {
    display:grid;
    justify-items:end;
    gap:calc(4 * var(--u));
    text-align:right;
  }
  .ns-score {
    font-size:calc(58 * var(--u));
    font-weight:800;
    letter-spacing:-.075em;
    font-variant-numeric:tabular-nums;
    line-height:.95;
  }
  .ns-score-label { font-size:calc(12 * var(--u)); font-weight:700; letter-spacing:.14em; }
  .ns-severity {
    display:inline-block;
    max-width:100%;
    padding:calc(3 * var(--u)) calc(7 * var(--u));
    border:var(--rule) solid #151515;
    border-radius:calc(4 * var(--u));
    font-size:calc(14 * var(--u));
    font-weight:700;
    line-height:1;
  }
  .ns-severity--critical { color:#fff; background:#151515; }
  .ns-digest { min-width:0; margin:0 var(--pad); border-top:calc(2 * var(--rule)) solid #151515; }
  .ns-digest-title {
    margin:calc(7 * var(--u)) 0 0;
    font-size:calc(12 * var(--u));
    font-weight:700;
    letter-spacing:.13em;
    text-transform:uppercase;
  }
  .ns-list { list-style:none; margin:0; padding:0; }
  .ns-row {
    display:grid;
    grid-template-columns:minmax(0,1fr) auto;
    align-items:center;
    gap:calc(8 * var(--u));
    min-height:calc(48 * var(--u));
    padding:calc(5 * var(--u)) 0;
  }
  .ns-row + .ns-row { border-top:var(--rule) solid #151515; }
  .ns--full .ns-digest { flex:1; display:flex; flex-direction:column; }
  .ns--full .ns-list { flex:1; display:flex; flex-direction:column; }
  .ns--full .ns-row { flex:1; max-height:calc(64 * var(--u)); }
  .ns-row-title { font-size:calc(18 * var(--u)); font-weight:700; line-height:1.12; }
  .ns-row-detail { margin-top:calc(2 * var(--u)); font-size:calc(14 * var(--u)); line-height:1.15; }
  .ns-row-right { display:flex; align-items:center; gap:calc(6 * var(--u)); }
  .ns-row-score { font-size:calc(16 * var(--u)); font-weight:700; font-variant-numeric:tabular-nums; }
  .ns-foot {
    display:flex;
    flex-wrap:wrap;
    justify-content:space-between;
    gap:calc(5 * var(--u));
    padding:calc(6 * var(--u)) var(--pad);
    border-top:var(--rule) solid #151515;
    font-size:calc(13 * var(--u));
    line-height:1.15;
  }
  .ns-empty {
    display:grid;
    align-content:center;
    justify-items:start;
    height:100%;
    padding:var(--pad);
  }
  .ns-empty .ns-subject { font-size:calc(29 * var(--u)); }
  .ns--half_horizontal .ns-content {
    display:grid;
    grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);
    align-items:center;
  }
  .ns--half_horizontal .ns-content--notice,
  .ns--half_horizontal .ns-content--single { grid-template-columns:minmax(0,1fr); }
  .ns--half_horizontal .ns-digest {
    margin:0 var(--pad) 0 0;
    border-top:0;
    border-inline-start:var(--rule) solid #151515;
    padding-inline-start:calc(12 * var(--u));
  }
  .ns--half_horizontal .ns-feature { gap:calc(10 * var(--u)); }
  .ns--half_horizontal .ns-subject { font-size:calc(30 * var(--u)); }
  .ns--half_horizontal .ns-score { font-size:calc(44 * var(--u)); }
  .ns--half_horizontal .ns-row { min-height:calc(44 * var(--u)); }
  .ns--half_horizontal .ns-row-score { display:none; }
  .ns--half_vertical .ns-heading, .ns--quadrant .ns-heading { font-size:calc(21 * var(--u)); }
  .ns--half_vertical .ns-mast, .ns--quadrant .ns-mast { gap:calc(8 * var(--u)); }
  .ns--half_vertical .ns-mark, .ns--quadrant .ns-mark { width:calc(27 * var(--u)); height:calc(27 * var(--u)); }
  .ns--half_vertical .ns-scope, .ns--quadrant .ns-scope { font-size:calc(12 * var(--u)); max-width:calc(66 * var(--u)); }
  .ns--half_vertical .ns-subject, .ns--quadrant .ns-subject { font-size:calc(27 * var(--u)); }
  .ns--half_vertical .ns-score, .ns--quadrant .ns-score { font-size:calc(42 * var(--u)); }
  .ns--half_vertical .ns-feature, .ns--quadrant .ns-feature { gap:calc(9 * var(--u)); }
  .ns--quadrant .ns-content { justify-content:center; }
  .ns--quadrant .ns-feature { padding-block:calc(8 * var(--u)); }
  @container (max-aspect-ratio: 5/2) {
    .ns--half_horizontal .ns-content { grid-template-columns:minmax(0,1fr); }
    .ns--half_horizontal .ns-digest {
      margin:0 var(--pad);
      border-top:var(--rule) solid #151515;
      border-inline-start:0;
      padding-inline-start:0;
    }
  }
</style>

<div class="layout layout--stretch">
  <section class="ns ns--{{ view }}" aria-label="Nutanix {{ heading }}">
    <div class="ns-board">
      <header class="ns-mast">
        <svg viewBox="0 0 256 256" class="ns-mark" aria-hidden="true">
          <path fill-rule="evenodd" d="
            M27 27H90L128 65L166 27H229V90L191 128L229 166V229H166L128 191L90 229H27V166L65 128L27 90Z
            M35 35H86L128 77L170 35H221V86L179 128L221 170V221H170L128 179L86 221H35V170L77 128L35 86Z"/>
        </svg>
        <div>
          <div class="ns-brand">NUTANIX{% if is_nxvd %} · NXVD{% endif %}</div>
          <h1 class="ns-heading">{{ heading }}</h1>
        </div>
        <div class="ns-scope">
          {% if feed_state == 'ERROR' %}Source error
          {% elsif lead %}{{ record_count }} {% if is_nxvd %}on page{% else %}published{% endif %}
          {% endif %}
        </div>
      </header>

      {% if feed_state == 'ERROR' or lead == blank %}
        <div class="ns-content ns-content--notice">
          <div class="ns-empty">
            {% if feed_state == 'ERROR' %}
              <div class="ns-meta">{{ source_error | default: 'Source error' | escape }}</div>
              <h2 class="ns-subject">Nutanix feed unavailable</h2>
              <div class="ns-detail">{{ source_message | default: 'Check the plugin Debug Logs.' | escape }}</div>
            {% elsif is_nxvd %}
              <h2 class="ns-subject">No released fixes on this page</h2>
              <div class="ns-detail">Check the selected product in NXVD.</div>
            {% else %}
              <h2 class="ns-subject">No advisories returned</h2>
              <div class="ns-detail">Check the Nutanix advisory feed.</div>
            {% endif %}
          </div>
        </div>
      {% else %}
        <div class="ns-content{% if record_count == 1 %} ns-content--single{% endif %}">
          <article class="ns-feature" data-ns-lead>
            <div>
              <div class="ns-meta">
                {% if is_nxvd %}
                  <span class="ns-meta-label">By CVSS</span>
                  {% if lead.cesa != blank %}<span>{{ lead.cesa | escape }}</span>{% endif %}
                {% else %}
                  <span class="ns-meta-label">Latest advisory</span>
                  {% if lead.date != blank %}<time>{{ lead.date | escape }}</time>{% endif %}
                  {% if lead.href contains 'https://download.nutanix.com/alerts/' %}
                    <a href="{{ lead.href | escape }}" title="Download advisory PDF">SA #{{ lead.advisoryNumber | escape }}</a>
                  {% else %}
                    <span>SA #{{ lead.advisoryNumber | escape }}</span>
                  {% endif %}
                {% endif %}
              </div>
              <h2 class="ns-subject ns-clip">{% render "nutanix_subject", entry: lead, mode: current_mode %}</h2>
              {% if is_nxvd %}
                <div class="ns-detail ns-clip">{{ lead.product | escape }}{% if lead.package != blank %} · {{ lead.package | escape }}{% endif %}</div>
                {% if lead.fixed != blank %}<div class="ns-detail ns-clip"><strong>Fixed in</strong> {{ lead.fixed | escape }}</div>{% endif %}
              {% elsif lead.affectedVersions != blank %}
                <div class="ns-detail ns-clip"><strong>Affects</strong> {{ lead.affectedVersions | escape }}</div>
              {% endif %}
            </div>
            <div class="ns-impact">
              {% if is_nxvd %}
                {% if lead.cvss != blank %}<div class="ns-score">{{ lead.cvss | escape }}</div><div class="ns-score-label">CVSS</div>{% endif %}
                {% render "nutanix_severity", value: lead.severity %}
              {% else %}
                {% render "nutanix_severity", value: lead.criticality %}
              {% endif %}
            </div>
          </article>

          {% if row_limit > 0 and record_count > 1 %}
            <section class="ns-digest">
              <h2 class="ns-digest-title">{% if is_nxvd %}More released fixes{% else %}Earlier advisories{% endif %}</h2>
              <ul class="ns-list">
                {% for entry in records offset: 1 limit: row_limit %}
                  <li class="ns-row" data-ns-row>
                    <div>
                      <div class="ns-row-title ns-clip">{% render "nutanix_subject", entry: entry, mode: current_mode %}</div>
                      <div class="ns-row-detail ns-clip">
                        {% if is_nxvd %}
                          <strong>{{ entry.product | escape }}</strong>{% if entry.package != blank %} · {{ entry.package | escape }}{% endif %}
                          {% if entry.fixed != blank %} · Fixed in {{ entry.fixed | escape }}{% endif %}
                        {% else %}
                          SA #{{ entry.advisoryNumber | escape }}{% if entry.date != blank %} · {{ entry.date | escape }}{% endif %}
                        {% endif %}
                      </div>
                    </div>
                    <div class="ns-row-right">
                      {% if is_nxvd %}
                        {% if entry.cvss != blank %}<span class="ns-row-score">{{ entry.cvss | escape }}</span>{% endif %}
                        {% render "nutanix_severity", value: entry.severity %}
                      {% else %}
                        {% render "nutanix_severity", value: entry.criticality %}
                      {% endif %}
                    </div>
                  </li>
                {% endfor %}
              </ul>
            </section>
          {% endif %}
        </div>
      {% endif %}

      <footer class="ns-foot" data-ns-footer>
        {% if is_nxvd %}
          <span>Verify deployed versions</span>
        {% elsif lead.date != blank and feed_state != 'ERROR' %}
          {% assign latest_count = records | where: 'date', lead.date | size %}
          <span>{{ latest_count }} published {{ lead.date | date: '%b %-d' | escape }}</span>
        {% endif %}
        <a href="{{ site_url }}">Nutanix Support</a>
      </footer>
    </div>
  </section>
</div>
{% endtemplate %}
