{% template nutanix_subject %}
{%- if mode == 'nxvd' -%}
  {%- assign first_cve = entry.cve | split: ', ' | first -%}
  {{- first_cve | default: entry.cesa | default: entry.package | default: 'Vulnerability fix' | escape -}}
{%- else -%}
  {%- assign subject = entry.summary | strip -%}
  {%- assign prefix = subject | split: ' for ' | first | downcase -%}
  {%- if prefix == 'investigation and breakfix guidance' or prefix == 'investigation and break-fix guidance' or prefix == 'investigation and break fix guidance' -%}
    {%- assign prefix_length = prefix.size | plus: 5 -%}
    {%- assign subject = subject | slice: prefix_length, subject.size -%}
  {%- endif -%}
  {{- subject | default: 'Security advisory' | escape -}}
{%- endif -%}
{% endtemplate %}

{% template nutanix_severity %}
{%- assign severity = value | default: 'Unrated' -%}
<span class="label label--small {% if severity == 'Critical' %}label--filled{% else %}label--outline{% endif %}">{{ severity | escape }}</span>
{% endtemplate %}

{% template nutanix_table %}
{% assign current_mode = mode | default: 'advisories' %}
{% assign is_nxvd = false %}
{% assign heading = 'Security advisories' %}
{% assign records = content.body | reverse %}
{% if current_mode == 'nxvd' %}
  {% assign is_nxvd = true %}
  {% assign heading = 'Vulnerability fixes' %}
  {% assign records = nxvd.rows %}
{% endif %}
{% assign record_count = records.size | default: 0 %}
{% assign lead = records.first %}
{% assign wide = false %}
{% if view == 'full' or view == 'half_horizontal' %}{% assign wide = true %}{% endif %}
{% assign split = false %}
{% if view == 'half_horizontal' and record_count > 1 %}{% assign split = true %}{% endif %}
{% assign narrow = false %}
{% if view == 'quadrant' or view == 'half_vertical' %}{% assign narrow = true %}{% endif %}
{% assign subject_width = 'w--[60cqw] portrait:w--[55cqw]' %}
{% case view %}
  {% when 'full' %}
    {% if is_nxvd %}
      {% assign subject_width = 'w--[60cqw] lg:landscape:w--[16cqw]' %}
    {% else %}
      {% assign subject_width = 'w--[65cqw] lg:landscape:w--[38cqw]' %}
    {% endif %}
  {% when 'half_horizontal' %}
    {% assign subject_width = 'w--[22cqw] lg:landscape:w--[15cqw] portrait:w--[60cqw]' %}
{% endcase %}

<div class="layout layout--col layout--stretch gap--none">
  <section class="flex flex--col w--full h--full gap--none" aria-label="Nutanix {{ heading }}">
    <header class="flex flex--row flex--center-y w--full inverse rounded py--2 {% if narrow %}gap--xsmall px--2{% else %}gap--small px--3{% endif %}" data-ns-mast>
      <svg viewBox="0 0 256 256" class="w--7 h--7 lg:w--9 lg:h--9 no-shrink {% if narrow %}portrait:w--5 portrait:h--5{% endif %}" aria-hidden="true">
        <path fill="currentColor" fill-rule="evenodd" d="
          M27 27H90L128 65L166 27H229V90L191 128L229 166V229H166L128 191L90 229H27V166L65 128L27 90Z
          M35 35H86L128 77L170 35H221V86L179 128L221 170V221H170L128 179L86 221H35V170L77 128L35 86Z"/>
      </svg>
      <div class="grow w--min-0">
        <div class="label label--small text--bold">NUTANIX{% if is_nxvd %} · NXVD{% endif %}</div>
        <div class="title title--base text--bold {% if narrow %}portrait:title--small lg:portrait:title--base{% else %}lg:title--large{% endif %}" role="heading" aria-level="1">{{ heading }}</div>
      </div>
      {% if feed_state == 'ERROR' or lead %}
        <div class="label label--small text--bold text--right no-shrink {% if narrow %}portrait:w--max-14{% endif %}">
          {% if feed_state == 'ERROR' %}Source error
          {% else %}{{ record_count }} {% if is_nxvd %}on page{% else %}published{% endif %}
          {% endif %}
        </div>
      {% endif %}
    </header>

    {% if feed_state == 'ERROR' or lead == blank %}
      <div class="flex flex--col flex--center-y gap--xsmall grow w--full px--3">
        {% if feed_state == 'ERROR' %}
          <div class="label label--outline">{{ source_error | default: 'Source error' | escape }}</div>
          <div class="title text--center">Nutanix feed unavailable</div>
          <div class="description text--center">{{ source_message | default: 'Check the plugin Debug Logs.' | escape }}</div>
        {% elsif is_nxvd %}
          <div class="title text--center">No released fixes on this page</div>
          <div class="description text--center">Check the selected product in NXVD.</div>
        {% else %}
          <div class="title text--center">No advisories returned</div>
          <div class="description text--center">Check the Nutanix advisory feed.</div>
        {% endif %}
      </div>
    {% else %}
      <div class="w--full grow px--3 py--2 h--min-0 {% if split %}grid grid--cols-5 portrait:flex portrait:flex--col gap--medium{% else %}flex flex--col gap--small{% if view == 'full' and record_count > 1 %} lg:landscape:grid lg:landscape:grid--cols-6 lg:landscape:gap--large{% elsif view == 'quadrant' or record_count == 1 %} flex--center-y{% if record_count > 1 %} lg:flex--top{% endif %}{% endif %}{% endif %}">
        <article class="flex flex--row flex--center-y flex--between gap--small w--full no-shrink {% if split %}col--span-3 self--center{% elsif view == 'full' and record_count > 1 %}lg:landscape:col--span-2 lg:landscape:self--start lg:landscape:flex--col lg:landscape:flex--left lg:landscape:bg--gray-75 lg:landscape:p--4 rounded{% endif %} {% if narrow %}portrait:flex--col portrait:flex--left{% endif %}" data-ns-lead>
          <div class="grow w--min-0 {% if narrow %}portrait:w--full{% elsif view == 'full' %}lg:landscape:w--full{% endif %}">
            <div class="flex flex--row flex--left flex--wrap gap--xsmall">
              {% if is_nxvd %}
                <span class="label label--small text--bold">BY CVSS</span>
                {% if lead.cesa != blank %}<span class="label label--small">{{ lead.cesa | escape }}</span>{% endif %}
              {% else %}
                <span class="label label--small text--bold">LATEST ADVISORY</span>
                {% if lead.date != blank %}<time class="label label--small">{{ lead.date | escape }}</time>{% endif %}
                <span class="label label--small">SA #{{ lead.advisoryNumber | escape }}</span>
              {% endif %}
            </div>
            <div class="title text--bold {% if view == 'full' %}title--large lg:portrait:title--xxlarge{% else %}title--base lg:title--large{% endif %} my--1" data-ns-subject data-clamp="2" role="heading" aria-level="2">{% render "nutanix_subject", entry: lead, mode: current_mode %}</div>
            {% if is_nxvd %}
              <div class="description description--large" data-clamp="1">{{ lead.product | escape }}{% if lead.package != blank %} · {{ lead.package | escape }}{% endif %}</div>
              {% if lead.fixed != blank %}<div class="description description--large" data-clamp="1"><strong>Fixed in</strong> {{ lead.fixed | escape }}</div>{% endif %}
            {% elsif lead.affectedVersions != blank %}
              <div class="description description--large" data-clamp="1"><strong>Affects</strong> {{ lead.affectedVersions | escape }}</div>
            {% endif %}
          </div>
          <div class="flex flex--col no-shrink gap--none flex--right text--right {% if narrow %}portrait:flex--row portrait:gap--xsmall portrait:flex--center-y{% elsif view == 'full' %}lg:landscape:flex--row lg:landscape:gap--xsmall lg:landscape:flex--center-y{% endif %}">
            {% if is_nxvd %}
              {% if lead.cvss != blank %}
                <div class="value value--tnums text--bold {% if view == 'full' %}value--large lg:value--xlarge{% else %}value--base lg:value--large{% endif %}" data-ns-score>{{ lead.cvss | escape }}</div>
                <span class="label label--small text--bold">CVSS</span>
              {% endif %}
              {% render "nutanix_severity", value: lead.severity %}
            {% else %}
              {% render "nutanix_severity", value: lead.criticality %}
            {% endif %}
          </div>
        </article>

        {% if record_count > 1 %}
          {% comment %}Allow for row heights changing when the framework clamps text.{% endcomment %}
          <section class="flex flex--col flex--top self--stretch w--full h--min-0 grow gap--none pb--6 lg:pb--7 {% if split %}col--span-2{% elsif view == 'full' %}lg:landscape:col--span-4{% elsif view == 'quadrant' %}hidden lg:flex{% endif %}" aria-label="{% if is_nxvd %}More released fixes{% else %}Earlier advisories{% endif %}">
            <div class="w--full grow h--min-0">
              <table class="table {% if split or view == 'quadrant' %}table--xsmall lg:table--small{% else %}table--small{% endif %}" data-table-limit="true" data-table-overflow-counter="false">
                <thead>
                  <tr>
                    <th scope="col"><span class="title title--small">{% if is_nxvd %}Released fixes{% else %}Earlier advisories{% endif %}</span></th>
                    {% if wide %}
                      <th scope="col" class="hidden lg:landscape:table-cell"><span class="title title--small">{% if is_nxvd %}Product{% else %}Published{% endif %}</span></th>
                      {% if is_nxvd and view == 'full' %}<th scope="col" class="hidden lg:landscape:table-cell"><span class="title title--small">Fixed in</span></th>{% endif %}
                    {% endif %}
                    <th scope="col" class="text--right">
                      <span class="title title--small {% if is_nxvd and narrow %}portrait:hidden lg:portrait:inline{% endif %}">{% if is_nxvd %}CVSS{% else %}Severity{% endif %}</span>
                      {% if is_nxvd and narrow %}<span class="title title--small hidden portrait:inline lg:portrait:hidden">Severity</span>{% endif %}
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {% for entry in records offset: 1 %}
                    <tr data-ns-row>
                      <td>
                        <div class="flex flex--col flex--left gap--none {{ subject_width }}">
                          <div class="label text--bold w--full" data-clamp="1">{% render "nutanix_subject", entry: entry, mode: current_mode %}</div>
                          {% unless split or view == 'quadrant' %}
                            <div class="description w--full {% if wide %}lg:landscape:hidden{% endif %}" data-clamp="1">{% if is_nxvd %}{{ entry.product | escape }}{% else %}{{ entry.date | escape }}{% endif %}</div>
                          {% endunless %}
                        </div>
                      </td>
                      {% if wide %}
                        <td class="hidden lg:landscape:table-cell">
                          <div class="flex {% if is_nxvd %}w--[9cqw]{% else %}w--[12cqw]{% endif %}">
                            <div class="label label--small w--full" data-clamp="1">{% if is_nxvd %}{{ entry.product | escape }}{% else %}{{ entry.date | date: '%b %-d, %Y' | escape }}{% endif %}</div>
                          </div>
                        </td>
                        {% if is_nxvd and view == 'full' %}
                          <td class="hidden lg:landscape:table-cell">
                            <div class="flex w--[20cqw]">
                              <div class="label label--small w--full" data-clamp="1">{{ entry.fixed | default: '—' | escape }}</div>
                            </div>
                          </td>
                        {% endif %}
                      {% endif %}
                      <td class="text--right">
                        {% if is_nxvd %}
                          {% if entry.cvss != blank %}<span class="label label--small text--bold {% if narrow %}portrait:hidden lg:portrait:inline{% endif %}">{{ entry.cvss | escape }}</span>{% endif %}
                          {% render "nutanix_severity", value: entry.severity %}
                        {% else %}
                          {% render "nutanix_severity", value: entry.criticality %}
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </section>
        {% endif %}
      </div>
    {% endif %}
  </section>
</div>

{% endtemplate %}
